"""
Repository Interface Module

This module defines the abstract base interfaces for repository patterns
used throughout the rural hospital digital system.
"""

from abc import ABC, abstractmethod
from typing import Generic, TypeVar, List, Optional, Dict, Any

T = TypeVar('T')


class IRepository(ABC, Generic[T]):
    """
    Generic repository interface defining CRUD operations and basic queries.
    """

    @abstractmethod
    def create(self, entity: T) -> T:
        """
        Create and persist a new entity.
        
        Args:
            entity: The entity to create
            
        Returns:
            The created entity with generated ID
        """
        pass

    @abstractmethod
    def get_by_id(self, entity_id: Any) -> Optional[T]:
        """
        Retrieve an entity by its ID.
        
        Args:
            entity_id: The unique identifier of the entity
            
        Returns:
            The entity if found, None otherwise
        """
        pass

    @abstractmethod
    def get_all(self) -> List[T]:
        """
        Retrieve all entities.
        
        Returns:
            List of all entities
        """
        pass

    @abstractmethod
    def update(self, entity_id: Any, entity: T) -> Optional[T]:
        """
        Update an existing entity.
        
        Args:
            entity_id: The unique identifier of the entity to update
            entity: The updated entity data
            
        Returns:
            The updated entity if successful, None otherwise
        """
        pass

    @abstractmethod
    def delete(self, entity_id: Any) -> bool:
        """
        Delete an entity by its ID.
        
        Args:
            entity_id: The unique identifier of the entity to delete
            
        Returns:
            True if deletion was successful, False otherwise
        """
        pass


class IQueryRepository(ABC, Generic[T]):
    """
    Extended repository interface for advanced query operations.
    """

    @abstractmethod
    def query(self, filters: Dict[str, Any]) -> List[T]:
        """
        Query entities using filter criteria.
        
        Args:
            filters: Dictionary of filter criteria
            
        Returns:
            List of entities matching the filters
        """
        pass

    @abstractmethod
    def count(self, filters: Optional[Dict[str, Any]] = None) -> int:
        """
        Count entities matching optional filter criteria.
        
        Args:
            filters: Optional dictionary of filter criteria
            
        Returns:
            Number of entities matching the criteria
        """
        pass

    @abstractmethod
    def exists(self, entity_id: Any) -> bool:
        """
        Check if an entity exists by its ID.
        
        Args:
            entity_id: The unique identifier to check
            
        Returns:
            True if the entity exists, False otherwise
        """
        pass


class IUnitOfWork(ABC):
    """
    Unit of Work pattern interface for managing transactions across multiple repositories.
    """

    @abstractmethod
    def begin_transaction(self):
        """Begin a new database transaction."""
        pass

    @abstractmethod
    def commit(self):
        """Commit the current transaction."""
        pass

    @abstractmethod
    def rollback(self):
        """Rollback the current transaction."""
        pass

    @abstractmethod
    def get_repository(self, repository_type):
        """
        Get a specific repository instance.
        
        Args:
            repository_type: The type of repository to retrieve
            
        Returns:
            The repository instance
        """
        pass


class IDataAccessObject(ABC):
    """
    Data Access Object interface for direct database operations.
    """

    @abstractmethod
    def execute_query(self, query: str, parameters: Optional[List[Any]] = None) -> List[Dict[str, Any]]:
        """
        Execute a SELECT query.
        
        Args:
            query: SQL query string
            parameters: Optional query parameters
            
        Returns:
            List of result rows as dictionaries
        """
        pass

    @abstractmethod
    def execute_insert(self, query: str, parameters: Optional[List[Any]] = None) -> Any:
        """
        Execute an INSERT query.
        
        Args:
            query: SQL query string
            parameters: Optional query parameters
            
        Returns:
            The ID of the inserted record
        """
        pass

    @abstractmethod
    def execute_update(self, query: str, parameters: Optional[List[Any]] = None) -> int:
        """
        Execute an UPDATE query.
        
        Args:
            query: SQL query string
            parameters: Optional query parameters
            
        Returns:
            Number of rows affected
        """
        pass

    @abstractmethod
    def execute_delete(self, query: str, parameters: Optional[List[Any]] = None) -> int:
        """
        Execute a DELETE query.
        
        Args:
            query: SQL query string
            parameters: Optional query parameters
            
        Returns:
            Number of rows affected
        """
        pass
